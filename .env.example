# ============================================================
# Online Vehicle Inspection Client — Environment Variables
# Copy to .env.local for local dev. Set in Netlify for production.
# NEVER commit real secrets.
# ============================================================

# --- Site ---
# Public site URL. Used as WP Origin header + SEO canonical.
# Locally leave unset (falls back to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# --- WordPress ---
# GraphQL endpoint of the WordPress backend (WPGraphQL plugin required).
WORDPRESS_GRAPHQL_URL=
# HTTP header name used for WP Site Token auth. When left empty, the code
# defaults to the same header name used by the WP backend.
WP_SITE_TOKEN_HEADER=
WP_SITE_TOKEN_SECRET=

# --- Auth (NextAuth) ---
# Canonical URL (http://localhost:3000 locally, https://... in prod).
AUTH_URL=
AUTH_SECRET=

# --- Google OAuth ---
# Create app at https://console.cloud.google.com/apis/credentials
# Redirect URI: <SITE>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe ---
# Secret key and webhook signing secret from the Stripe dashboard.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret from Stripe dashboard webhook endpoint:
# <SITE>/api/webhooks/stripe  (events: payment_intent.succeeded, payment_intent.payment_failed, payment_intent.requires_action, payment_intent.canceled)
STRIPE_WEBHOOK_SECRET=

# --- WordPress Webhook Service Account ---
# WP user (e.g. "webhook") with edit_posts capability; used by Stripe webhook to auth WPGraphQL mutations.
WP_WEBHOOK_USERNAME=
WP_WEBHOOK_PASSWORD=

# --- Uploads: Bunny Storage (primary provider) ---
# All four are required for Bunny mode. The server action presigns a PUT URL
# against Bunny's S3-compatible endpoint (https://{region}-s3.storage.bunnycdn.com)
# so files upload directly from the browser — no secret ever reaches the client.
#   - BUNNY_STORAGE_ZONE_NAME  = storage zone name (S3 Access Key ID / bucket)
#   - BUNNY_STORAGE_PASSWORD   = storage zone password (S3 Secret Access Key)
#   - BUNNY_STORAGE_REGION     = zone region code (e.g. ny)
#   - BUNNY_PULL_ZONE_HOSTNAME = pull zone hostname, e.g. yourzone.b-cdn.net
BUNNY_STORAGE_ZONE_NAME=
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_REGION=
BUNNY_PULL_ZONE_HOSTNAME=
# Set to true to enable Bunny Dynamic Image params (images served via smart
# optimization / dynamic resizing on the CDN edge).
BUNNY_OPTIMIZER_ENABLED=

# --- Uploads: Uploadcare (DORMANT — not used) ---
# Kept only as a possible dev emergency fallback. No code path references these
# anymore; re-enable only by restoring the provider branch in app/actions/upload.ts.
UPLOADCARE_PUBLIC_KEY=
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=

# --- E2E Tests ---
TEST_EMAIL=
TEST_PASSWORD=